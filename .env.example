# ── Database ──────────────────────────────────────────────────────────────────
DATABASE_URL="postgresql://user:password@localhost:5432/elite_edge_fitness"

# ── NextAuth ──────────────────────────────────────────────────────────────────
NEXTAUTH_SECRET="your-random-32-char-secret"
NEXTAUTH_URL="http://localhost:3000"

# ── Razorpay ──────────────────────────────────────────────────────────────────
RAZORPAY_KEY_ID="rzp_test_xxxxxxxxxxxx"
RAZORPAY_KEY_SECRET="your-razorpay-key-secret"
NEXT_PUBLIC_RAZORPAY_KEY_ID="rzp_test_xxxxxxxxxxxx"

# ── Cloudflare R2 ─────────────────────────────────────────────────────────────
# Endpoint format: https://<ACCOUNT_ID>.r2.cloudflarestorage.com
R2_ENDPOINT="https://xxxxxxxxxxxxxxxxxxxx.r2.cloudflarestorage.com"
R2_ACCESS_KEY_ID="your-r2-access-key-id"
R2_SECRET_ACCESS_KEY="your-r2-secret-access-key"
R2_BUCKET_NAME="elite-edge-fitness"
# Public URL of your R2 bucket (enable public access or use custom domain)
R2_PUBLIC_URL="https://pub-xxxxxxxxxxxx.r2.dev"

# ── Email via Brevo (SMTP) ────────────────────────────────────────────────────
# Brevo SMTP: smtp-relay.brevo.com:587
# Get credentials at: app.brevo.com → SMTP & API → SMTP
SMTP_HOST="smtp-relay.brevo.com"
SMTP_PORT="587"
SMTP_USER="your-brevo-login-email@example.com"
SMTP_PASS="your-brevo-smtp-key"
EMAIL_FROM="Elite Edge Fitness <noreply@eliteedgefitness.in>"
EMAIL_TO="contact@eliteedgefitness.in"
